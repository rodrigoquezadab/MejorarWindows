                         "category":  "Standard Tweaks",
                         "panel":  "1",
                         "Order":  "a005_",
                         "registry":  [
                                          {
                                              "Path":  "HKCU:\\System\\GameConfigStore",
                                              "Name":  "GameDVR_FSEBehavior",
                                              "Type":  "DWord",
                                              "Value":  "2",
                                              "OriginalValue":  "0"
                                          },
                                          {
                                              "Path":  "HKCU:\\System\\GameConfigStore",
                                              "Name":  "GameDVR_Enabled",
